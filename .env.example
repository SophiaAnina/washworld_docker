# Copy to .env (docker compose reads it automatically). Do not commit .env.
# Must match the password hardcoded in washworld_eksamen_backend_2026/x.py
DB_ROOT_PASSWORD=password

# URL the BROWSER uses to reach the Flask API (baked into the frontend at build time).
# Change it (and rebuild) if you access the app through ngrok or an SSH tunnel with other ports.
NEXT_PUBLIC_API_URL=http://localhost:80

# Only for docker-compose.ngrok.yml (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=
